<!-- Header card: keyboard picture, name, connection state and firmware. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical" android:gravity="center_horizontal"
 android:layout_marginHorizontal="16dp" android:layout_marginVertical="8dp"
 android:paddingHorizontal="24dp" android:paddingTop="24dp" android:paddingBottom="20dp"
 android:background="@drawable/accessory_card_background">
 <ImageView android:id="@android:id/icon" android:layout_width="match_parent"
  android:layout_height="132dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
 <TextView android:id="@android:id/title" android:layout_width="wrap_content"
  android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center"
  android:textAppearance="?android:attr/textAppearanceLarge" />
 <TextView android:id="@android:id/summary" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center"
  android:accessibilityLiveRegion="polite"
  android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
