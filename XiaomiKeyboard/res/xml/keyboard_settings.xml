<!-- Laid out like HyperOS: header card, then keys, backlight, touchpad,
     cover, desktop windowing, firmware update and about. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/keyboard_settings_title">

    <Preference
        android:key="keyboard_illustration"
        android:title="@string/keyboard_name"
        android:summary="@string/keyboard_header_disconnected"
        android:icon="@drawable/accessory_keyboard_show_icon"
        app:layout="@layout/accessory_hero_preference"
        android:selectable="false"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="keyboard_not_connected"
        android:icon="@drawable/ic_info"
        android:summary="@string/keyboard_not_connected"
        android:selectable="false" />

    <PreferenceCategory
        android:key="keyboard_keys_category"
        android:title="@string/keyboard_category_keys">

        <Preference
            android:key="keyboard_special_keys"
            android:icon="@drawable/ic_keyboard"
            android:title="@string/keyboard_special_keys_title"
            android:summary="@string/keyboard_special_keys_summary"
            android:selectable="false" />

        <Preference
            android:key="keyboard_shortcuts"
            android:icon="@drawable/ic_apps"
            android:title="@string/keyboard_layout_title"
            android:summary="@string/keyboard_layout_summary">
            <intent android:action="android.settings.HARD_KEYBOARD_SETTINGS" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="keyboard_backlight_category"
        android:title="@string/keyboard_category_backlight">

        <SwitchPreferenceCompat
            android:key="keyboard_backlight_auto"
            android:icon="@drawable/ic_brightness"
            android:title="@string/keyboard_backlight_auto_title"
            android:summary="@string/keyboard_backlight_auto_summary"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="keyboard_backlight_level"
            android:title="@string/keyboard_backlight_title"
            android:summary="@string/keyboard_backlight_summary"
            android:max="100"
            android:defaultValue="50"
            app:min="0"
            app:showSeekBarValue="true"
            app:updatesContinuously="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="keyboard_touchpad_category"
        android:title="@string/keyboard_category_touchpad">

        <SwitchPreferenceCompat
            android:key="keyboard_touchpad"
            android:icon="@drawable/ic_mouse"
            android:title="@string/keyboard_touchpad_title"
            android:summary="@string/keyboard_touchpad_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="keyboard_cover_category"
        android:title="@string/keyboard_category_cover">

        <Preference
            android:key="keyboard_angle"
            android:icon="@drawable/ic_laptop"
            android:title="@string/keyboard_angle_title"
            android:summary="@string/keyboard_angle_summary"
            android:selectable="false" />

        <SwitchPreferenceCompat
            android:key="keyboard_show_ime"
            android:icon="@drawable/ic_keyboard"
            android:title="@string/keyboard_show_ime_title"
            android:summary="@string/keyboard_show_ime_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="desktop_windowing_category"
        android:title="@string/desktop_windowing_title">

        <SwitchPreferenceCompat
            android:key="desktop_windowing"
            android:icon="@drawable/ic_desktop_windows"
            android:title="@string/desktop_windowing_title"
            android:summary="@string/desktop_windowing_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="keyboard_update_category"
        android:title="@string/keyboard_category_update">

        <Preference
            android:key="keyboard_update"
            android:icon="@drawable/ic_system_update"
            android:title="@string/keyboard_update_title" />

        <Preference
            android:key="touchpad_update"
            android:icon="@drawable/ic_system_update"
            android:title="@string/touchpad_update_title" />

        <Preference
            android:key="mcu_update"
            android:icon="@drawable/ic_system_update"
            android:title="@string/mcu_update_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="keyboard_about"
        android:title="@string/keyboard_category_about">

        <Preference
            android:key="keyboard_model"
            android:icon="@drawable/ic_info"
            android:title="@string/keyboard_model_title"
            android:selectable="false" />

        <Preference
            android:key="keyboard_version"
            android:title="@string/keyboard_version_title"
            android:selectable="false" />

        <Preference
            android:key="touchpad_version"
            android:title="@string/touchpad_version_title"
            android:selectable="false" />

        <Preference
            android:key="mcu_version"
            android:title="@string/mcu_version_title"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
