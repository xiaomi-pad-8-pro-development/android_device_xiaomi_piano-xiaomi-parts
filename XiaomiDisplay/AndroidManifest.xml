<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.xiaomidisplay"
    android:sharedUserId="android.uid.system">

    <!-- The reading mode paper texture overlay. -->
    <uses-permission android:name="android.permission.INTERNAL_SYSTEM_WINDOW" />

    <application
        android:name=".DisplayApplication"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true">

        <service
            android:name=".SunlightModeTileService"
            android:icon="@drawable/ic_sunlight_tile"
            android:label="@string/sunlight_mode_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="org.lineageos.qs.CATEGORY_DEVICE" />
        </service>

        <service
            android:name=".TrueToneTileService"
            android:icon="@drawable/ic_true_tone_tile"
            android:label="@string/true_tone_title"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="org.lineageos.qs.CATEGORY_DEVICE" />
        </service>

        <!-- Takes LiveDisplay's place in Settings > Display, as on HyperOS. -->
        <activity
            android:name=".ColorSchemeActivity"
            android:exported="true"
            android:label="@string/color_scheme_title"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                       android:value="com.android.settings.category.ia.display" />
            <meta-data android:name="com.android.settings.group_key"
                       android:value="category_key_color" />
            <meta-data android:name="com.android.settings.order"
                       android:value="-10" />
            <meta-data android:name="com.android.settings.summary"
                       android:resource="@string/color_scheme_summary" />
        </activity>

        <!-- Stock HyperOS lists reading mode in Settings > Display too. -->
        <activity
            android:name=".ReadingModeActivity"
            android:exported="true"
            android:label="@string/reading_mode_title"
            android:theme="@style/Theme.SubSettingsBase.Expressive">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                       android:value="com.android.settings.category.ia.display" />
            <meta-data android:name="com.android.settings.group_key"
                       android:value="category_key_color" />
            <meta-data android:name="com.android.settings.order"
                       android:value="-9" />
            <meta-data android:name="com.android.settings.summary"
                       android:resource="@string/reading_mode_summary" />
        </activity>

    </application>
</manifest>
