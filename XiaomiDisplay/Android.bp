//

android_app {
    name: "XiaomiDisplay",
    srcs: [
        "src/**/*.java",
        ":xiaomi-parts-aidl",
    ],
    aidl: {
        include_dirs: ["device/xiaomi/piano-xiaomi-parts/aidl"],
    },
    resource_dirs: ["res"],
    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
        "org.lineageos.platform.internal",
    ],
    min_sdk_version: "current",
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp-permissions-xiaomidisplay.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-xiaomidisplay.xml",
    src: "privapp-permissions-xiaomidisplay.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
