android_app {
    name: "PianoPencilEngine",
    min_sdk_version: "36",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java", ":piano-pencilengine-transport-sources"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: { enabled: false },
    required: ["privapp-permissions-com.xiaomi.touchservice.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-com.xiaomi.touchservice.xml",
    src: "privapp-permissions-com.xiaomi.touchservice.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
