soong_namespace {}

filegroup {
    name: "piano-pencilengine-transport-sources",
    srcs: ["XiaomiStylus/src/org/lineageos/xiaomistylus/pencilengine/*.java"],
}

filegroup {
    name: "xiaomi-parts-aidl",
    srcs: ["aidl/**/*.aidl"],
    path: "aidl",
}

android_app {
    name: "PianoParts",
    // Shared with Android 16 and 17. SettingsLib requires the current
    // platform API (37 on EvoX A17), so a fixed 36 fails manifest merging.
    min_sdk_version: "current",
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
        ":xiaomi-parts-aidl",
    ],
    aidl: {
        local_include_dirs: ["aidl"],
    },
    resource_dirs: ["res"],
    libs: ["framework-bluetooth.stubs.module_lib"],
    static_libs: [
        "SettingsLib",
        "androidx.preference_preference",
        "org.lineageos.platform.internal",
    ],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
}

